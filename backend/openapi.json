    "/search/brokers": {
      "get": {
        "operationId": "SearchController_findBrokers",
        "summary": "Mirrors DiscoveryService.findBrokers, ranked server-side via PostGIS.",
        "parameters": [
          {
            "name": "lat",
            "required": true,
            "in": "query",
            "description": "Client latitude — required to rank/sort by distance.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lng",
            "required": true,
            "in": "query",
            "description": "Client longitude — required to rank/sort by distance.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "transaction",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "RENT",
                "SALE"
              ],
              "type": "string"
            }
          },
          {
            "name": "kind",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "APARTMENT",
                "HOUSE",
                "LAND",
                "STUDIO",
                "ROOM"
              ],
              "type": "string"
            }
          },
          {
            "name": "maxPrice",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "radiusMeters",
            "required": false,
            "in": "query",
            "description": "Meters.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "query",
            "required": false,
            "in": "query",
            "description": "Free text against broker name/coverage or property title/neighbourhood.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 0,
              "default": 0,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrokerSearchResultsDto"
                }
              }
            }
          }
        },
        "tags": [
          "search"
        ]
      }
    },
