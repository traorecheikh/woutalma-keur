# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL="postgresql://woutalma:woutalma@localhost:5433/woutalma?schema=public"

# OPTIONAL. OAuth 2.0 client ID from Google Cloud Console (Android + Web client
# IDs both accepted as audiences — see auth/providers/google-auth.provider.ts).
# Unset is a supported deployment: the app still boots and POST /auth/google
# answers 503 instead of taking the whole API down at startup.
GOOGLE_CLIENT_ID="replace-me.apps.googleusercontent.com"

# Session tokens. Rotate before shipping past Phase 1 — a single static
# secret is a Phase 1 simplification, not a production posture.
JWT_SECRET="replace-me-with-a-long-random-value"
JWT_ACCESS_TOKEN_TTL="15m"
JWT_REFRESH_TOKEN_TTL="30d"

# Separate moderator console credentials. Never use these placeholder values.
ADMIN_EMAIL="admin@woutalma.sn"
ADMIN_PASSWORD="replace-with-a-long-random-password"
ADMIN_TOKEN_TTL="8h"

# Dev sign-in. Opens POST /auth/dev, which mints real JWTs for two seeded demo
# personas (client, broker) without a Google OAuth client. Both variables are
# required together: DEV_AUTH_ENABLED="true" with a missing or under-32-char
# DEV_AUTH_SECRET refuses to boot rather than exposing an unauthenticated
# token mint. Leave DEV_AUTH_ENABLED unset and the route answers 404.
DEV_AUTH_ENABLED=""
DEV_AUTH_SECRET=""

# Comma-separated allowed origins. Unset reflects the request origin, which is
# the right default for a public read API using bearer (not cookie) auth.
CORS_ORIGINS=""

PORT=3000
